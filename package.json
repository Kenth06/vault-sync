{
  "name": "vault-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "oxlint --type-aware && node scripts/check-comments.mjs apps packages",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test",
    "dev:worker": "pnpm --filter @vault-sync/web build && wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types apps/web/worker/worker-configuration.d.ts"
  },
  "devDependencies": {
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.11",
    "typescript": "~5.9.3",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "cloudflare": {
    "bindings": {
      "ADMIN_SECRET": {
        "description": "Enrolls devices (CLI, plugin, viewer). At least 32 random characters, e.g. the output of `openssl rand -base64 32`. Keep it in a password manager."
      }
    }
  }
}
