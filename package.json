{
  "name": "vault-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "oxlint --type-aware && node scripts/check-comments.mjs apps packages",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test"
  },
  "devDependencies": {
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.11",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
