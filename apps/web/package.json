    "@hono/zod-validator": "^0.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vault-sync/protocol": "workspace:*",
    "dompurify": "^3.4.18",
    "hono": "^4.13.19",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vault-sync/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "4.164.0"
