{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/**"],
  "workspaces": {
    "apps/api": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/sync-core": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/obsidian-plugin": {
      "entry": ["src/main.ts", "build.mjs"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
