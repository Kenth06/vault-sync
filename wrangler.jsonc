{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault-sync",
  "main": "apps/web/worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },

  "build": { "command": "pnpm --filter @vault-sync/web build" },

  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/health"],
  },

  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "VaultDO" }],
  },
  "exports": {
    "VaultDO": { "type": "durable-object", "storage": "sqlite" },
  },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "vault-sync" }],

  "vars": { "GC_GRACE_MS": "604800000" },
  "secrets": { "required": ["ADMIN_SECRET"] },

  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
}
